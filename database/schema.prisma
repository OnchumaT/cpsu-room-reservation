// CPSU Room Reservation System — database schema.
//
// Lives in its own top-level database/ folder (a sibling of backend/), so
// `output` is pinned explicitly to backend/node_modules/.prisma/client —
// otherwise Prisma's default output resolution (relative to this file)
// would generate the client into the repo root's node_modules instead of
// backend's, where backend/src/lib/prisma.js actually looks for it.
//
// Field set is shaped to match the existing frontend prototype's domain
// entities (frontend/src/domain/entities) so the API layer can map rows
// to those entities directly — Room.status/floor/colorHue, Booking's
// bundled participants/note/participatingTeachers/equipment/food, a
// bundled per-booking FacilityRequest, audience-based rich Notifications,
// and per-user Templates all exist here for that reason, alongside the
// management-position RBAC / audit log / approval-mode pieces that don't
// map to any pre-existing frontend concept.

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  teacher
  staff
  admin
  // System-assigned only (never admin-settable) — a Google self-signup
  // that hasn't been given a real role yet. See AuthService.loginWithGoogle
  // and CreateBookingUseCase's pending guard.
  pending
}

// Which tier a can_approve ManagementPosition sits at. department = head/
// vice-head, today's only approvers. `faculty` (Dean-level) was a second
// approval stage for out-of-hours bookings that has since been removed
// from the app — kept in the enum only so existing rows/migrations don't
// break; no code path assigns or checks it anymore.
enum PositionLevel {
  department
  faculty
}

// Who opens/closes the room for a booking — the booker themselves, or
// someone else (captured via roomResponsibleName/Phone on Booking).
enum RoomResponsibleType {
  self
  other
}

enum ApprovalMode {
  auto
  manual
}

enum BookingStatus {
  pending
  // Unused: was the "awaiting the faculty/dean stage" status of a removed
  // 2-stage approval flow. No longer written by the app — kept only so
  // existing rows/migrations don't break.
  pending_faculty
  approved
  rejected
  cancelled
  expired
  // Approved, but nobody checked in (QR at the room door) within the grace
  // period after the start — released by jobs/noShowJob.js.
  no_show
}

enum RoomStatus {
  available
  occupied
  pending
}

enum FacilityRequestStatus {
  pending
  accepted
  done
  // Closed by Staff after the booking time passed without the items
  // having been prepared — kept distinct from `done` so the record (and the
  // requester's notification) stays truthful.
  not_done
}

enum NotificationKind {
  booking
  facility_request
  user_registration
}

// Who a notification is broadcast to. `approvers` replaces what the
// frontend prototype called the 'head' audience — approval authority
// comes from a can_approve ManagementPosition, not a Role, so anyone
// holding one (regardless of Role) sees the `approvers` inbox merged
// into their own role's inbox at the API layer.
enum NotificationAudience {
  teacher
  staff
  admin
  approvers
  // Unused: was the Faculty/Dean-level approver audience for a removed
  // 2-stage approval flow. Kept only so existing rows/migrations don't break.
  faculty_approvers
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // bcrypt hash
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  managementPositions UserManagementPosition[]
  bookings            Booking[]                 @relation("BookingRequester")
  approvedBookings    Booking[]                 @relation("BookingApprover")
  approvedFacultyBookings Booking[]             @relation("BookingFacultyApprover")
  updatedSettings     BookingSetting[]
  templates           Template[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  timetableImports    TimetableImport[]
  clashAttempts       ClashAttempt[]

  @@map("users")
}

model ManagementPosition {
  id           Int           @id @default(autoincrement())
  positionName String        @map("position_name")
  canApprove   Boolean       @default(false) @map("can_approve")
  // department (head/vice-head) vs faculty (dean) — see PositionLevel.
  level        PositionLevel @default(department)

  users UserManagementPosition[]

  @@map("management_positions")
}

// Admin-managed calendar of annual/special (ครม.-announced) Thai public
// holidays — e.g. Songkran, New Year, a royal birthday. Weekends (Sat/Sun)
// are out-of-hours too, but that's computed directly from the date, not
// stored here — this table only covers the holidays that vary by year and
// aren't computable from a formula. See OfficeHoursPolicy. Matched by
// exact date; no recurrence rule.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("holidays")
}

model UserManagementPosition {
  id         Int @id @default(autoincrement())
  userId     Int @map("user_id")
  positionId Int @map("position_id")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  position ManagementPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
  @@map("user_management_positions")
}

// Admin-chosen id (e.g. "1637") rather than an autoincrement surrogate —
// the frontend's "add room" form has the admin type the room code
// directly (matches how the department actually numbers its rooms).
model Room {
  id        String     @id
  name      String
  capacity  Int
  status    RoomStatus @default(available)
  floor     Int        @default(1)
  // HSL hue (0-359) — picked by the admin in the add/edit room form, or
  // auto-assigned at creation (spaced via golden-angle picking — see
  // CreateRoomUseCase) when they leave it blank. Null
  // for the 5 original rooms, which use a hand-curated color instead (see
  // frontend/src/shared/roomColors.js's ROOM_COLORS).
  colorHue  Int?       @map("color_hue")
  // Which building this room is in — a real, admin-managed list (see
  // Building below) rather than free text, so the booking form can offer
  // "pick a building, then pick a room in it" instead of retyping names.
  buildingId Int?      @map("building_id")
  equipment Json?
  isActive  Boolean    @default(true) @map("is_active")
  // Secret baked into the room's check-in QR code, so a check-in proves the
  // person was at the door (the URL can't be guessed). Created on first use.
  checkInToken String?   @unique @map("check_in_token")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  building  Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  bookings  Booking[]
  templates Template[]
  classSchedules ClassSchedule[]
  clashAttempts  ClashAttempt[]

  @@map("rooms")
}

// Admin-managed list of buildings a room can belong to — created
// independently of any room (see CreateBuildingUseCase), then assigned to
// rooms via Room.buildingId. Deleting a building clears it from any room
// still pointing at it (onDelete: SetNull above) rather than failing.
model Building {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  rooms Room[]

  @@map("buildings")
}

// Shared equipment pool for facility requests (mic/whiteboard/extension
// cord/HDMI, matching BOOKING_EQUIPMENT_OPTIONS' `k` keys on the
// frontend) — a simple aggregate count, not per-serial tracking: `total`
// is how many the department owns, `damaged` is how many are currently
// out of commission, and `total - damaged` is what the booking form
// shows as "คงเหลือ". Staff/admin adjust both from "จัดการอุปกรณ์".
model Equipment {
  key       String   @id
  name      String
  unit      String
  iconKey   String   @map("icon_key")
  total     Int
  damaged   Int      @default(0)
  // Soft delete: a removed item drops out of the booking form and the
  // management list, but old bookings/requests still name it correctly.
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("equipment")
}

// Single-row table: the department-wide default approval mode.
model BookingSetting {
  id             Int          @id @default(autoincrement())
  approvalMode   ApprovalMode @default(manual) @map("approval_mode")
  // How many days into the future a booking may be made — enforced by
  // CreateBookingUseCase/EditBookingUseCase, not just shown as a UI hint.
  maxAdvanceDays Int          @default(60) @map("max_advance_days")
  // How many days of past booking data to keep "active" before an admin
  // can archive it out of the dashboard via ArchiveOldBookingsUseCase.
  retentionDays  Int          @default(365) @map("retention_days")
  // The three system-settings toggles on SettingsView — gate the
  // best-effort approval email, the room-overlap check (CreateBookingUseCase),
  // and the 30-minutes-before reminder job (jobs/reminderJob.js).
  emailNotificationsEnabled     Boolean @default(true)  @map("email_notifications_enabled")
  preventOverlapBooking         Boolean @default(true)  @map("prevent_overlap_booking")
  reminderBeforeBookingEnabled  Boolean @default(false) @map("reminder_before_booking_enabled")
  // QR check-in: when on, an approved in-hours booking nobody checks into
  // within checkInGraceMinutes after its start is released (no_show).
  checkInRequired               Boolean @default(false) @map("check_in_required")
  checkInGraceMinutes           Int     @default(15)    @map("check_in_grace_minutes")
  updatedBy      Int?         @map("updated_by")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  updatedByUser User? @relation(fields: [updatedBy], references: [id])

  @@map("booking_settings")
}

model Booking {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  roomId       String        @map("room_id")
  // Denormalized snapshot of the requester's role at booking time — the
  // frontend UI branches on "whose booking is this" (inbox routing,
  // facility-panel eligibility) independent of the requester's *current*
  // role, which could change after the fact.
  role         Role
  bookingDate  DateTime      @db.Date @map("booking_date")
  startTime    DateTime      @db.Time(0) @map("start_time")
  endTime      DateTime      @db.Time(0) @map("end_time")
  purpose      String        @db.Text
  participants Int           @default(10)
  note         String?       @db.Text
  // Array of participating-teacher name strings — kept as opaque display
  // data (no FK), matching how the frontend collects them.
  participatingTeachers Json? @map("participating_teachers")
  // A teacher booking a room on a student's behalf (the booking stays
  // theirs — userId/role above are still the teacher's) can attach who
  // it's actually for: an array of { name, studentId } objects, same
  // opaque-JSON, no-FK shape as participatingTeachers above.
  bookingForStudents Json? @map("booking_for_students")
  // Bundled facility ask, embedded on the booking itself (frontend shows
  // these directly on the booking) — mirrored into a FacilityRequest row
  // for Staff's queue workflow (accept/done) when non-empty.
  equipment    Json?
  food         Json?
  facilityNote String?       @db.Text @map("facility_note")
  status       BookingStatus @default(pending)
  approvalType ApprovalMode  @map("approval_type")
  // Department-level (head/vice-head) approval — the only approval stage;
  // out-of-hours bookings go through this same field, they just always
  // require manual review (see OfficeHoursPolicy) rather than auto-approving.
  approvedBy   Int?          @map("approved_by")
  approvedAt   DateTime?     @map("approved_at")
  rejectReason String?       @db.Text @map("reject_reason")
  // True when the booking's date/time falls outside normal office hours
  // (see OfficeHoursPolicy) — once such a booking is approved, Staff gets
  // a task to print a memo notifying the Dean (see ApproveRejectBookingUseCase
  // and printFacultyMemo.js). Reuses the requires_faculty_approval column
  // from a removed 2-stage approval flow instead of a new migration — a
  // booking only ever got flagged there when it was out-of-hours, so the
  // meaning carries over unchanged.
  isOutOfHours Boolean @default(false) @map("requires_faculty_approval")
  // Unused: these two fields backed the removed 2-stage flow's second
  // (faculty/dean) approval. No longer read or written by the app — kept
  // only so existing rows/migrations don't break.
  facultyApprovedBy       Int?      @map("faculty_approved_by")
  facultyApprovedAt       DateTime? @map("faculty_approved_at")
  // Who opens/closes the room for this booking — the booker themselves, or
  // someone else (name/phone required in that case, validated in
  // CreateBookingUseCase not the DB).
  roomResponsibleType  RoomResponsibleType @default(self) @map("room_responsible_type")
  roomResponsibleName  String?             @map("room_responsible_name")
  roomResponsiblePhone String?             @db.VarChar(30) @map("room_responsible_phone")
  // Soft-archived out of dashboard/analytics queries once past the
  // configured BookingSetting.retentionDays — the row itself, and a
  // user's own history of it, is left untouched.
  isArchived   Boolean       @default(false) @map("is_archived")
  archivedAt   DateTime?     @map("archived_at")
  // Set once jobs/reminderJob.js sends the 30-minutes-before notification,
  // so a later tick never re-notifies the same booking.
  reminderSentAt DateTime?   @map("reminder_sent_at")
  // When the booker (or Staff on their behalf) checked in at the room.
  checkedInAt    DateTime?   @map("checked_in_at")
  // Set once jobs/pendingAlertJob.js warns Staff that this booking is close
  // to its start and still not approved, so it isn't warned about twice.
  pendingAlertSentAt DateTime? @map("pending_alert_sent_at")
  // Shared by every day of one multi-day booking (same room and time on
  // each date in a start–end range, one row per day) — approved, rejected
  // and cancelled together. Null for an ordinary single-day booking. See
  // CreateBookingUseCase and MultiDayBookingPolicy.
  groupId        String?     @db.VarChar(36) @map("group_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user             User              @relation("BookingRequester", fields: [userId], references: [id])
  room             Room              @relation(fields: [roomId], references: [id])
  approver         User?             @relation("BookingApprover", fields: [approvedBy], references: [id])
  facultyApprover  User?             @relation("BookingFacultyApprover", fields: [facultyApprovedBy], references: [id])
  facilityRequests FacilityRequest[]
  notifications    Notification[]

  // Backs the overlap check: WHERE room_id = ? AND booking_date = ? AND
  // start_time < ? AND end_time > ? — this composite index makes that a
  // fast index range scan instead of a full table scan.
  @@index([roomId, bookingDate, startTime, endTime])
  @@index([groupId])
  @@map("bookings")
}

// One row per booking's facility ask (not per item — equipment/food are
// bundled JSON here, matching the frontend's FacilityRequest entity),
// worked through Staff's queue via status: pending -> accepted -> done.
model FacilityRequest {
  id        Int                   @id @default(autoincrement())
  bookingId Int                   @map("booking_id")
  equipment Json
  food      Json
  note      String?               @db.Text
  status    FacilityRequestStatus @default(pending)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  // Set once jobs/facilityRequestReminderJob.js sends the day-before
  // "still pending" nudge to staff, so a later tick never re-notifies it.
  staffReminderSentAt DateTime?   @map("staff_reminder_sent_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("facility_requests")
}

// Shared work-queue events (new booking, cancellation FYI, new user
// registration) broadcast per audience so a whole role's inbox stays in
// sync. `approvers` notifications are additionally shown to any user
// holding a can_approve ManagementPosition, merged with their own role's
// inbox at the API layer. Anything owner-facing (approved/rejected/
// cancelled/facility-request status) is personal instead, targeted at a
// single `userId`, so one user never sees another user's booking updates.
// A row is either a broadcast (`audience` set, `userId` null) or personal
// (`userId` set, `audience` null).
model Notification {
  id          Int                   @id @default(autoincrement())
  audience    NotificationAudience?
  userId      Int?                  @map("user_id")
  unread      Boolean               @default(true)
  iconKey     String?               @map("icon_key")
  iconBg      String?               @map("icon_bg")
  title       String
  subtitle    String?               @db.Text
  status      String?
  statusBg    String?               @map("status_bg")
  statusColor String?               @map("status_color")
  actions     Json?
  bookingId   Int?                  @map("booking_id")
  kind        NotificationKind      @default(booking)
  createdAt   DateTime              @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([audience, unread])
  @@index([userId, unread])
  @@map("notifications")
}

// Scoped per-user (each user only sees their own saved templates) rather
// than per-role, unlike the frontend prototype's in-memory version — see
// backend/README.md for why.
model Template {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  roomId       String   @map("room_id")
  name         String
  purpose      String
  participants Int      @default(10)
  note         String?  @db.Text
  equipment    Json?
  food         Json?
  facilityNote String?  @db.Text @map("facility_note")
  participatingTeachers Json? @map("participating_teachers")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id])

  @@map("templates")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Timetable import log: who imported which file for which term, and how many rows changed.
model TimetableImport {
  id            Int      @id @default(autoincrement())
  academicYear  String   @map("academic_year") @db.VarChar(64)
  semester      String   @db.VarChar(64)
  building      String
  termStartDate DateTime? @map("term_start_date") @db.Date
  termEndDate   DateTime? @map("term_end_date") @db.Date
  fileName      String   @map("file_name")
  importedBy    Int      @map("imported_by")
  totalRows     Int      @map("total_rows")
  addedCount    Int      @map("added_count")
  updatedCount  Int      @map("updated_count")
  importedAt    DateTime @default(now()) @map("imported_at")

  importer  User            @relation(fields: [importedBy], references: [id])
  schedules ClassSchedule[]

  @@index([importedBy])
  @@map("timetable_imports")
}

// One row of a class timetable for a room. (academicYear, semester, roomId, dayOfWeek,
// startTime, endTime, courseCode, section) is the identity used to update an existing row.
// A booking attempt that was refused because the room was already taken. Kept so the
// requester can be told when that slot frees up (see NotifyFreedSlotUseCase).
model ClashAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  roomId      String?  @map("room_id") @db.VarChar(64)
  bookingDate DateTime @db.Date @map("booking_date")
  startTime   DateTime @db.Time(0) @map("start_time")
  endTime     DateTime @db.Time(0) @map("end_time")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  room Room? @relation(fields: [roomId], references: [id])

  @@index([roomId, bookingDate])
  @@map("booking_clash_attempts")
}

model ClassSchedule {
  id           Int      @id @default(autoincrement())
  academicYear String   @map("academic_year") @db.VarChar(64)
  semester     String   @db.VarChar(64)
  roomId       String   @map("room_id") @db.VarChar(64)
  dayOfWeek    Int      @map("day_of_week") @db.TinyInt
  startTime    DateTime @map("start_time") @db.Time(0)
  endTime      DateTime @map("end_time") @db.Time(0)
  courseCode   String   @map("course_code") @db.VarChar(64)
  section      String   @db.VarChar(64)
  importId     Int      @map("import_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  room   Room           @relation(fields: [roomId], references: [id])
  import TimetableImport @relation(fields: [importId], references: [id])

  @@unique([academicYear, semester, roomId, dayOfWeek, startTime, endTime, courseCode, section], map: "class_schedules_term_key")
  @@index([roomId])
  @@index([importId])
  @@map("class_schedules")
}
