# Copy this file to .env and fill in real values. Never commit .env.

# Google OAuth Client ID (same one as backend/.env's GOOGLE_CLIENT_ID —
# the backend checks it as the ID token's `audience`). From Google Cloud
# Console -> Credentials -> OAuth client ID -> Web application, with
# http://localhost:5173 as an Authorized JavaScript origin. Google Sign-In
# stays a "not configured" toast on the login screen until this is set.
VITE_GOOGLE_CLIENT_ID=""
