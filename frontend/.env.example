# Copy this file to .env and fill in real values. Never commit .env.

# Base URL of the backend API, e.g. https://api.yourdomain.com/api. Baked
# into the build at `vite build` time (Vite only exposes VITE_-prefixed
# vars to the browser) — leave unset for local dev, where ApiClient.js
# falls back to http://localhost:4000/api. Must be set to the real deployed
# backend URL before building for production, or every request will try to
# reach localhost:4000 on the visitor's machine and fail instantly.
VITE_API_URL=""

# Google OAuth Client ID (same one as backend/.env's GOOGLE_CLIENT_ID —
# the backend checks it as the ID token's `audience`). Not a secret — see
# the comment in LoginView.jsx — this project's real Client ID is already
# the default there, so leave this blank/unset unless you're pointing at
# a different Google Cloud project (e.g. your own OAuth client, configured
# with http://localhost:5173 as an Authorized JavaScript origin).
VITE_GOOGLE_CLIENT_ID=""
