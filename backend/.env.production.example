# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Scratch database `prisma migrate dev` uses to diff schema changes —
# a fixed name (not Prisma's default random one) because cpsu_app only
# has ALTER privileges on this specific pre-provisioned database.
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Port the API server listens on
PORT=4000


# Secret used to sign JWTs — use a long random string in production
# (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret"

# JWT lifetime, e.g. "8h", "7d"
JWT_EXPIRES_IN="8h"

# Comma-separated list of origins allowed to call this API (the frontend dev server)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# Password every seeded demo account gets (see prisma/seed.js)
SEED_DEFAULT_PASSWORD="replace-me"

# Google OAuth Client ID (from Google Cloud Console -> Credentials), used to
# verify the ID token sent to POST /api/auth/google. Must match the
# audience the frontend's Google Sign-In button was configured with.
GOOGLE_CLIENT_ID="259562354585-ic65v7nsv6ue5mppeeflu8aclvm9sog3.apps.googleusercontent.com"
