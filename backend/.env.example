# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://cpsu_app:changeme@localhost:3306/cpsu_room_reservation"

# Scratch database `prisma migrate dev` uses to diff schema changes —
# a fixed name (not Prisma's default random one) because cpsu_app only
# has ALTER privileges on this specific pre-provisioned database.
SHADOW_DATABASE_URL="mysql://cpsu_app:changeme@localhost:3306/cpsu_room_reservation_shadow"

# Port the API server listens on
PORT=4000

# Secret used to sign JWTs — use a long random string in production
# (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret"

# JWT lifetime, e.g. "8h", "7d"
JWT_EXPIRES_IN="8h"

# Comma-separated list of origins allowed to call this API (the frontend dev server)
CORS_ORIGIN="http://localhost:5173"

# Password every seeded demo account gets (see scripts/seed.js)
SEED_DEFAULT_PASSWORD="Passw0rd!"

# Notification emails (every in-app notification can also go out by email,
# see email_outbox). A real SMTP server — e.g. Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=the account, SMTP_PASS=an app password. Leave
# SMTP_HOST blank to fall back to Ethereal below, or to send nothing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM='"CPSU Room Reservation" <no-reply@su.ac.th>'
# The frontend's address, linked from every email
APP_URL="http://localhost:5173"

# Ethereal (https://ethereal.email) test SMTP credentials — a sandbox that
# never delivers real mail, just captures it behind a preview link. Only
# used when SMTP_HOST is blank; leave both blank and no email is sent.
ETHEREAL_USER=""
ETHEREAL_PASS=""

# Google OAuth Client ID (from Google Cloud Console -> Credentials), used to
# verify the ID token sent to POST /api/auth/google. Must match
# frontend/.env's VITE_GOOGLE_CLIENT_ID (same value = the token's
# `audience`). Not a secret (see the comment in backend/src/config/env.js)
# — env.js already defaults to this project's real Client ID, so leave
# this blank/unset unless you're pointing at a different Google Cloud
# project (e.g. your own for local testing).
GOOGLE_CLIENT_ID=""

# Development only — set to 1 when this local database holds users synced from
# Cloud (passwords masked), so password logins are checked against Cloud via
# .env.sync.local. Leave unset on a real server.
# LOGIN_AGAINST_CLOUD=1
