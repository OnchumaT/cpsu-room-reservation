{
  "name": "cpsu-room-reservation-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the CPSU Room Reservation System (schema/migrations live in ../database)",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:local": "DOTENV_CONFIG_PATH=.env.local node --watch src/index.js",
    "start": "node src/index.js",
    "start:local": "DOTENV_CONFIG_PATH=.env.local node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node scripts/seed.js",
    "start:prod": "node --env-file=.env.production src/index.js",
    "prisma:deploy:prod": "node --env-file=.env.production ./node_modules/.bin/prisma migrate deploy",
    "start:sim": "PORT=4100 TRUST_PROXY=2 node src/index.js",
    "start:sim:cloud": "PORT=4100 TRUST_PROXY=2 node --env-file=.env.production src/index.js"
  },
  "prisma": {
    "schema": "../database/schema.prisma",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  }
}
